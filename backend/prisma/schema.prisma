// Prisma Schema for UniCampus PostgreSQL Database (Render-ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
}

enum AttendanceStatus {
  present
  absent
  late
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  password_hash String
  full_name     String
  role          Role         @default(student)
  group_name    String?      // For students, e.g., "CS-2401"
  department    String?      // For teachers, e.g., "Computer Science"
  created_at    DateTime     @default(now())

  courses_taught Course[]     @relation("TeacherCourses")
  grades_received Grade[]     @relation("StudentGrades")
  grades_given    Grade[]     @relation("TeacherGrades")
  attendance      Attendance[]
  room_bookings   RoomBooking[]

  @@map("users")
}

model Course {
  id          String       @id @default(uuid())
  title       String
  code        String       @unique
  credits     Int          @default(5)
  teacher_id  String
  teacher     User         @relation("TeacherCourses", fields: [teacher_id], references: [id], onDelete: Cascade)

  grades      Grade[]
  attendance  Attendance[]
  assignments Assignment[]
  schedules   Schedule[]

  @@map("courses")
}

model Grade {
  id          String   @id @default(uuid())
  student_id  String
  course_id   String
  teacher_id  String
  category    String   // e.g., "Assignment", "Midterm 1", "Midterm 2", "Final"
  score       Float    // 0 - 100
  feedback    String   @default("")
  updated_at  DateTime @default(now()) @updatedAt

  student     User     @relation("StudentGrades", fields: [student_id], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  teacher     User     @relation("TeacherGrades", fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("grades")
}

model Attendance {
  id          String           @id @default(uuid())
  student_id  String
  course_id   String
  date        String           // YYYY-MM-DD
  status      AttendanceStatus @default(present)

  student     User             @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([student_id, course_id, date])
  @@map("attendance")
}

model Assignment {
  id          String   @id @default(uuid())
  course_id   String
  group_name  String   // e.g., "CS-2401" or "ALL"
  title       String
  description String   @default("")
  due_date    String
  category    String   @default("assignment")
  weight      String   @default("10%")

  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("assignments")
}

model Schedule {
  id             String   @id @default(uuid())
  course_id      String?
  course_name    String
  course_code    String
  professor      String
  group_name     String   @default("CS-2401")
  day            String   // "Mon" | "Tue" | "Wed" | "Thu" | "Fri"
  start_time     String
  end_time       String
  time_row_index Int      @default(1)
  duration_hours Float    @default(1)
  room           String
  building       String
  color          String   @default("blue")

  course         Course?  @relation(fields: [course_id], references: [id], onDelete: SetNull)

  @@map("schedule")
}

model RoomBooking {
  id            String   @id @default(uuid())
  user_id       String?
  user_name     String   @default("Student")
  user_role     String   @default("student")
  room_number   String
  building_name String
  date          String
  time_slot     String
  purpose       String
  status        String   @default("pending") // "confirmed" | "pending" | "rejected"
  created_at    DateTime @default(now())

  user          User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("room_bookings")
}
